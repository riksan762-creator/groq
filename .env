# === Server ===
PORT=4000
# URL frontend kamu (GitHub Pages), dipakai untuk CORS
FRONTEND_URL=https://username.github.io
# URL publik backend ini sendiri (dipakai widget.js untuk tahu ke mana harus manggil API)
APP_BASE_URL=https://api.domainkamu.com

# === Auth ===
# String rahasia acak untuk enkripsi JWT. Generate sendiri, jangan pakai contoh ini.
# Cara generate di VPS: openssl rand -hex 32
JWT_SECRET=ganti_dengan_hasil_openssl_rand_hex_32

# === Groq ===
# Ambil di https://console.groq.com/keys
GROQ_API_KEY=gsk_isi_dengan_api_key_groq_kamu
GROQ_MODEL=llama-3.3-70b-versatile

# === AutoGoPay (payment gateway) ===
# 1. Daftar gratis di https://autogopay.site/register
# 2. Beli Activation Key lewat bot Telegram @AutoGopayBot
# 3. Ambil API key dari dashboard AutoGoPay setelah aktif
AUTOGOPAY_API_KEY=agp_isi_dengan_api_key_autogopay_kamu
AUTOGOPAY_BASE_URL=https://v1-gateway.autogopay.site
