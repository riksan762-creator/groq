# Server
PORT=3000
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
ADMIN_PASSWORD=ganti-password-admin

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Cek model terbaru di https://console.groq.com/docs/models sebelum deploy —
# Groq sering deprecate model lama. Dua default di bawah aktif per dokumentasi
# saat kode ini dibuat.
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# AutoGoPay (dokumentasi resmi: https://autogopay.site/docs)
AUTOGOPAY_API_KEY=agp_xxxxxxxxxxxxxxxxxxxx
AUTOGOPAY_BASE_URL=https://v1-gateway.autogopay.site
# Tidak perlu secret terpisah untuk webhook — API key di atas JUGA dipakai
# sebagai HMAC secret untuk verifikasi header X-Signature (lihat server/autogopay.js)
